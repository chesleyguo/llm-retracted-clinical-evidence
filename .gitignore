.env
# Raw data is downloaded locally, never committed (see README).
# The .gitkeep is kept so the folder exists after cloning.
data/raw/*
!data/raw/.gitkeep
# Exceptions: caches used to match controls (step 09) are committed so the
# controls can be reproduced exactly; PubMed changes over time.
!data/raw/pubmed_controls/
!data/raw/mesh/
!data/raw/pubmed_p1/
!data/raw/openalex_p1/
.venv/
.DS_Store
__pycache__/
# Large intermediate files; regenerate with scripts/06 and scripts/07 (see README)
data/processed/retractions_eligible.csv
data/processed/pubmed_metadata.csv
